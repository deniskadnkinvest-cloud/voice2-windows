<Window x:Class="Voice2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice2 — Начало работы"
        Width="400" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="300" Margin="20">

            <!-- Logo -->
            <TextBlock Text="🎙 Voice2"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0 0 0 6"/>
            <TextBlock Text="Голосовой ввод без облака"
                       FontSize="13" Foreground="#666"
                       HorizontalAlignment="Center" Margin="0 0 0 28"/>

            <!-- Email field -->
            <TextBlock Text="Введи email чтобы начать"
                       FontSize="12" FontWeight="SemiBold" Margin="0 0 0 6"/>
            <TextBox x:Name="EmailBox"
                     FontSize="13" Padding="8 6"
                     BorderBrush="#CCC"
                     KeyDown="OnKeyDown"
                     TextChanged="OnTextChanged"/>
            <TextBlock Text="Используется для лимита слов. Писем не шлём."
                       FontSize="10" Foreground="#888" Margin="0 4 0 20"/>

            <!-- CTA button -->
            <Button x:Name="StartBtn"
                    Content="Начать — 2000 слов бесплатно"
                    FontSize="13" FontWeight="SemiBold"
                    Padding="0 10"
                    IsEnabled="False"
                    Click="OnStart"/>

        </StackPanel>
    </Grid>
</Window>
